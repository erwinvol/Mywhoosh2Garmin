# MyWhoosh Credentials
MYWHOOSH_EMAIL=your_mywhoosh_email@example.com
MYWHOOSH_PASSWORD=your_mywhoosh_password

# Garmin Connect Credentials
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Optional: Custom token directory (defaults to ./data/garmin_tokens)
GARMIN_TOKEN_DIR=./data/garmin_tokens

# Sync Configuration (default: 60 minutes)
# Set SYNC_INTERVAL_MINUTES=0 to disable periodic polling and use only on-demand Home Assistant webhooks
SYNC_INTERVAL_MINUTES=60
SYNC_BATCH_SIZE=10
CHECK_DUPLICATES=true
DUPLICATE_THRESHOLD_HOURS=2

# Webhook Configuration (On-Demand Sync Trigger from Home Assistant)
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0
# Shared secret token for authenticating webhook requests (passed via X-Webhook-Token or Authorization: Bearer)
WEBHOOK_TOKEN=your_secure_webhook_token_here

# Device Spoofing (Physio TrueUp / Training Load calculation in Garmin)
SPOOF_GARMIN_DEVICE=true
# 3927 = Garmin Edge 1040, 4024 = Garmin Edge 840
DEVICE_PRODUCT_ID=3927
DEVICE_SOFTWARE_VERSION=27.10

# Athlete FTP (Optional, for Normalized Power / TSS calculation in FIT file)
ATHLETE_FTP=0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data directory for SQLite sync state (defaults to ./data locally, /data in Docker)
DATA_DIR=./data
